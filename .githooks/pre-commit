#!/usr/bin/env bash
# Runs golangci-lint before commit when Go sources are staged.
# Install once: make install-hooks  (from repo root)
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if ! printf '%s\n' "$staged" | grep -qE '\.go$'; then
	exit 0
fi

echo "pre-commit: make lint (staged .go files)"
make -C core lint
